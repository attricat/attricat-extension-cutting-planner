              "maxLength": 128
            },
            "max_width": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "max_length": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "processes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "saw": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 32
                },
                "guillotine": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 32
                },
                "laser": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 32
                },
                "plasma": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "maxItems": 32
                }
              },
              "required": []
            }
          },
          "required": [
            "blueprint"
          ]
        },
        "production": {
          "type": "object",
          "additionalProperties": false,
