        }
      },
      "required": [
        "orders",
        "order_lines",
        "stock_levels",
        "machines",
        "production"
      ]
    }
  },
  "server": {
    "commands": [
      {
        "id": "list-orders",
        "handler": "list-orders",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "load-demand",
        "handler": "load-demand",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36
              },
              "minItems": 1,
              "maxItems": 50
            }
          },
          "required": [
            "order_ids"
          ]
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "load-stock",
        "handler": "load-stock",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "group_keys": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 1024
              },
              "maxItems": 200
            }
          },
          "required": [
            "group_keys"
          ]
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "save-plan",
        "handler": "save-plan",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan": {
              "type": "object",
              "required": [
                "id",
                "groups"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9-]{8,40}$"
                }
              }
            }
          },
          "required": [
            "plan"
          ]
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "get-plan",
        "handler": "get-plan",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{8,40}$"
            }
          },
          "required": [
            "plan_id"
          ]
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "list-plans",
        "handler": "list-plans",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "record_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            }
          },
          "required": []
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "check-plan",
        "handler": "check-plan",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{8,40}$"
            }
          },
          "required": [
            "plan_id"
          ]
        },
        "response_schema": {
          "type": "object"
        }
      },
      {
        "id": "create-production-orders",
        "handler": "create-production-orders",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plan_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{8,40}$"
            }
          },
          "required": [
            "plan_id"
          ]
        },
        "response_schema": {
          "type": "object"
        }
      }
    ],
    "operations": [
      {
        "id": "cutting-sheet",
        "handler": "cutting-sheet",
        "request_schema": {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        "max_request_bytes": 256,
        "max_checkpoint_bytes": 4096,
        "interactive": {
          "version": 1,
          "max_selection": 1
        }
      }
    ]
  },
  "ui": [
    {
      "id": "cutting-planner",
      "version": 1,
      "kind": "route",
      "artifact": "planner",
      "title": "Planer cięcia"
    },
    {
      "id": "cutting-planner-nav",
      "version": 1,
      "kind": "navigation",
      "route": "cutting-planner",
      "title": "Planer cięcia"
    },
    {
      "id": "plan-tab",
      "version": 1,
      "kind": "tab",
      "artifact": "plan-tab",
      "outlet": "record_tab",
      "view": "detail",
      "title": "Plan cięcia"
    },
    {
      "id": "cutting-sheet-dialog",
      "version": 1,
      "kind": "dialog",
      "artifact": "cutting-sheet-dialog",
      "outlet": "action_dialog",
      "title": "Karta cięcia"
    },
    {
      "id": "cutting-sheet",
      "version": 1,
      "kind": "action",
      "outlet": "record_action",
      "view": "detail",
      "title": "Karta cięcia…",
      "icon": "download",
      "invoke": {
        "dialog": "cutting-sheet-dialog"
      }
    }
  ]
}
