              "maxLength": 128
            }
          },
          "required": [
            "blueprint"
          ]
        },
        "machines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blueprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "process": {
              "type": "string",
              "minLength": 1,
