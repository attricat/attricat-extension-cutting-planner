              "maxLength": 128
            },
            "thickness": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "weight": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "rotate": {
              "type": "string",
