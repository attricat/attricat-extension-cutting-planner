{
  "manifest_version": 1,
  "name": "Planer cięcia",
  "version": "0.2.0",
  "description": "Planuje cięcie sztang i profili z magazynu, rysuje każdą sztangę w skali, porównuje odpad z cięciem po kolei i tworzy zlecenia produkcyjne z planu.",
  "icons": {
    "48": "assets/icon-48.svg"
  },
  "attricat": {
    "id": "attricat-extension-cutting-planner",
    "host_api": ">=1.2.0, <2.0.0"
  },
  "permissions": [
    "attricat.read",
    "attricat.write",
    "storage.extension",
    "configuration.read",
    "logging.write",
    "client.commands",
    "client.events",
    "client.navigation",
    "client.notification",
    "client.record_tab",
    "client.record_action",
    "client.action_dialog",
    "client.operations.start",
    "client.operations.read",
    "artifacts.write"
  ],
  "artifacts": [
    {
      "id": "server",
      "kind": "server_wasm",
      "path": "dist/server.wasm"
    },
    {
      "id": "planner",
      "kind": "client_frame",
      "path": "dist/planner.js"
    },
    {
      "id": "plan-tab",
      "kind": "client_frame",
      "path": "dist/plan-tab.js"
    },
    {
      "id": "cutting-sheet-dialog",
      "kind": "client_frame",
      "path": "dist/cutting-sheet-dialog.js"
    }
  ],
  "configuration": {
    "version": 1,
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
