            "density": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "via": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "attribute": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "via",
                "attribute"
              ]
            }
          },
          "required": [
            "pieces",
            "stock",
            "match"
          ]
        },
        "remnants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "blueprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
