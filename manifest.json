            "length": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "width": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "weight": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "copy": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 32
            }
          },
          "required": [
            "blueprint"
          ]
